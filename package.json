{
  "name": "little-island-games",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "expo": "~57.0.33",
    "expo-asset": "~57.0.21",
    "expo-audio": "~57.0.4",
    "expo-build-properties": "~57.0.23",
    "expo-constants": "~57.0.23",
    "expo-document-picker": "~57.0.1",
    "expo-file-system": "~57.0.6",
    "expo-haptics": "~57.0.3",
    "expo-linking": "~57.0.14",
    "expo-router": "~57.0.31",
    "expo-sharing": "~57.0.26",
    "expo-sqlite": "~57.0.5",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@types/react": "~19.2.10",
    "@types/react-test-renderer": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.0",
    "expo-doctor": "^1.21.5",
    "patch-package": "^8.0.1",
    "react-test-renderer": "19.2.3",
    "typescript": "~6.0.3",
    "vitest": "^5.0.5"
  },
  "scripts": {
    "start": "expo start --port 43820",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "web": "expo start --web --port 43820",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "export:web": "npm run library:validate && npm run library:index && expo export --platform web --clear && node scripts/offline-web.mjs",
    "save:catalog": "node --experimental-strip-types scripts/check-save-catalog.mjs",
    "puzzles": "node --import ./scripts/puzzles/register.mjs scripts/puzzles/cli.ts",
    "puzzles:verify": "npm run puzzles -- verify",
    "puzzles:scale": "node --expose-gc --import ./scripts/puzzles/register.mjs scripts/puzzles/cli.ts scale",
    "check": "npm run check:source && npm run check:words:export",
    "preview": "node scripts/serve.mjs",
    "doctor": "expo-doctor",
    "export:public": "node scripts/export-public.mjs",
    "library:validate": "node scripts/library/validate.mjs && npm run library:destinations",
    "library:validate:shipping": "node scripts/library/validate.mjs --shipping",
    "library:index": "node --experimental-strip-types scripts/library/build-index.mjs",
    "export:library-fixtures": "EXPO_PUBLIC_LIBRARY_FIXTURES=1 npm run export:web",
    "postinstall": "patch-package --error-on-fail --error-on-warn && npm run library:validate && npm run library:index",
    "library:destinations": "node scripts/library/destinations.mjs",
    "library:decisions": "node scripts/library/record-decisions.mjs",
    "ios:preview-bundle-prep": "node scripts/ios-preview-bundle.mjs prep",
    "ios:restore-generated": "node scripts/ios-preview-bundle.mjs restore",
    "ios:preview-build": "node scripts/ios-preview-bundle.mjs build --",
    "ios:dev": "node scripts/ios-dev.mjs",
    "registry:generate": "node scripts/generate-game-registry.mjs",
    "registry:check": "node scripts/generate-game-registry.mjs --check",
    "check:words": "node scripts/words/check.mjs full",
    "check:words:export": "node scripts/words/check.mjs export",
    "check:words:release": "node scripts/words/check.mjs release",
    "check:words:receipt": "node scripts/words/check.mjs receipt",
    "deliver:web": "node scripts/words/delivery.mjs web --",
    "deliver:ios": "node scripts/words/delivery.mjs ios --",
    "check:source": "npm run registry:check && npm run save:catalog && npm run puzzles:verify && npm run typecheck && npm run lint && npm test && npm run export:web",
    "arcade:boundaries": "LITTLE_ISLAND_WRITE_ARCADE_TABLE=1 vitest run tests/arcade-boundaries.test.ts",
    "arcade:dares": "node --import ./scripts/puzzles/register.mjs scripts/arcade/dare-catalog.ts",
    "arcade:certify": "node --import ./scripts/puzzles/register.mjs scripts/arcade/certify-curves.ts",
    "boards:catalog": "node --import ./scripts/puzzles/register.mjs scripts/boards/pits-catalog.ts",
    "qa:matrix": "node --experimental-strip-types scripts/qa/render.mjs",
    "qa:matrix:generate": "node --experimental-strip-types scripts/qa/render.mjs",
    "qa:evidence:verify": "node --experimental-strip-types scripts/qa/verify-evidence.mjs"
  },
  "private": true,
  "engines": {
    "node": "^22.18.0 || >=24.0.0"
  },
  "overrides": {
    "xcode": {
      "uuid": "11.1.1"
    }
  },
  "license": "MIT"
}
