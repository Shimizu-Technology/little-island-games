{
  "cli": {
    "version": ">=18.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "family": {
      "distribution": "internal",
      "ios": {
        "buildConfiguration": "Release"
      }
    },
    "simulator": {
      "distribution": "internal",
      "ios": {
        "simulator": true,
        "buildConfiguration": "Release"
      }
    },
    "production": {
      "autoIncrement": true
    }
  }
}
