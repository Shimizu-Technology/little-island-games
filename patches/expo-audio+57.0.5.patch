index 0000000..203ae0b
--- /dev/null
+++ b/node_modules/expo-audio/ios/AudioStatusQueue.swift
@@ -0,0 +1,95 @@
+import Foundation
+
+// Little Island patch (expo-audio 57.0.5): the serial queue that owns one player's or playlist's status events.
+// Reading -[AVPlayerItem currentTime] can wait on MediaToolbox's item lock while playback starts; on the main
+// queue that wait stalled UI frames on every short sound on iOS 18. Every status producer (periodic observer,
+// seek completion, playback end, KVO, loop and playlist changes, media-services reset) builds and emits its
+// status on this queue instead, in the order the producers queued it.
+//
+// The generation advances on play, item or player replacement and playlist changes, and status work from an
+// older generation is dropped. After a terminal (didJustFinish) status, the periodic observer of that generation
+// emits nothing more. Release closes the queue for good: nothing queued, in flight or submitted afterwards is
+// emitted, though queued work still runs, so seek continuations still resume. Anything a snapshot reads is
+// replaced inside `invalidate` or `locked`, under the lock the snapshot takes; AVFoundation reads, which can
+// block, run in `build` after that lock is released.
+final class AudioStatusQueue {
+  enum Kind {
+    case periodic
+    case event
+    case terminal
+  }
+
+  let queue = DispatchQueue(label: "expo.modules.audio.status", qos: .userInitiated)
+  // A leaf lock: no AVFoundation call, and no other lock, is ever taken while it is held.
+  private let lock = NSLock()
+  private var generation = 0
+  private var ended = false
+  private var closed = false
+
+  var current: Int {
+    locked { generation }
+  }
+
+  func locked<T>(_ body: () throws -> T) rethrows -> T {
+    lock.lock()
+    defer { lock.unlock() }
+    return try body()
+  }
+
+  /// Starts a new generation, applying `change` under the snapshot lock. Returns the new generation.
+  @discardableResult
+  func invalidate(_ change: () -> Void = {}) -> Int {
+    locked {
+      change()
+      generation &+= 1
+      ended = false
+      return generation
+    }
+  }
+
+  /// On release, before cancellation and teardown: rejects every status from now on, whatever its generation.
+  /// Later invalidations don't reopen the queue.
+  func close() {
+    locked {
+      closed = true
+      generation &+= 1
+    }
+  }
+
+  /// Runs `work` on the queue with the generation that is current now, from any thread.
+  func async(_ work: @escaping (_ generation: Int) -> Void) {
+    let generation = current
+    queue.async { work(generation) }
+  }
+
+  /// On the queue: takes `snapshot` under the lock (it must not block), builds the status from it without the
+  /// lock, then emits it only if its generation is still current. Returns whether it was emitted.
+  @discardableResult
+  func deliver<Snapshot, Status>(
+    _ kind: Kind,
+    generation expected: Int,
+    snapshot: () -> Snapshot?,
+    build: (Snapshot) -> Status,
+    emit: (Status) -> Void
+  ) -> Bool {
+    dispatchPrecondition(condition: .onQueue(queue))
+    guard let input = locked({ isCurrent(kind, expected) ? snapshot() : nil }) else {
+      return false
+    }
+    let status = build(input)
+    return locked {
+      guard isCurrent(kind, expected) else {
+        return false
+      }
+      emit(status)
+      if kind == .terminal {
+        ended = true
+      }
+      return true
+    }
+  }
+
+  private func isCurrent(_ kind: Kind, _ expected: Int) -> Bool {
+    !closed && generation == expected && !(kind == .periodic && ended)
+  }
+}
